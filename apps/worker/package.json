{
  "name": "@dyjext/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background job worker and weekly-cycle scheduler (BullMQ).",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch-path=dist --watch-preserve-output dist/main.js)",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@bull-board/api": "^9.14.0",
    "@bull-board/fastify": "^9.14.0",
    "@dyjext/db": "workspace:*",
    "@dyjext/jobs": "workspace:*",
    "bullmq": "6.7.10",
    "dotenv": "^18.0.10",
    "fastify": "5.12.8",
    "ioredis": "^6.1.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dyjext/config": "workspace:*",
    "@types/node": "^26.6.10",
    "eslint": "^10.15.0",
    "pino-pretty": "^13.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.2"
  }
}
