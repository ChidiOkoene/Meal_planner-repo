{
  "name": "@dyjext/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS HTTP API and webhooks (Stripe, Paystack, WhatsApp).",
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch-path=dist --watch-preserve-output dist/main.js)",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@dyjext/db": "workspace:*",
    "@dyjext/nutrition": "workspace:*",
    "@dyjext/planner": "workspace:*",
    "@dyjext/shared": "workspace:*",
    "@fastify/static": "^10.1.12",
    "@nestjs/common": "^12.6.2",
    "@nestjs/core": "^12.6.2",
    "@nestjs/platform-fastify": "^12.6.2",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/adapter-pg": "7.10.1",
    "dotenv": "^18.0.10",
    "fastify": "5.12.8",
    "ioredis": "^6.1.0",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dyjext/config": "workspace:*",
    "@types/node": "^26.6.10",
    "eslint": "^10.15.0",
    "pino-pretty": "^13.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.2"
  },
  "main": "./dist/main.js"
}
