{
  "name": "dyjext-care",
  "private": true,
  "description": "Healthy, condition-aware home meals for parents in Africa, paid for by family abroad.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @dyjext/db generate",
    "db:migrate": "pnpm --filter @dyjext/db migrate:dev",
    "db:deploy": "pnpm --filter @dyjext/db migrate:deploy",
    "db:check": "pnpm --filter @dyjext/db migrate:check",
    "db:seed": "pnpm --filter @dyjext/db seed",
    "db:studio": "pnpm --filter @dyjext/db studio",
    "catalogue:import": "pnpm --filter @dyjext/db catalogue:import"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3"
  }
}
