{
  "name": "@dyjext/jobs",
  "version": "0.0.0",
  "private": true,
  "description": "Job queues, the transactional outbox and idempotency helpers shared by the API and the worker.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@dyjext/db": "workspace:*",
    "bullmq": "6.7.10",
    "ioredis": "^6.1.0"
  },
  "devDependencies": {
    "@dyjext/config": "workspace:*",
    "@types/node": "^26.6.10",
    "eslint": "^10.15.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.2"
  }
}
