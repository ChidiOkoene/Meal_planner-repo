# Copy to .env and adjust. Never commit a real .env file.

# Runtime
NODE_ENV=development
TZ=UTC

# PostgreSQL (matches docker-compose.yml for local development)
DATABASE_URL=postgresql://dyjext:dyjext_local_only@localhost:5432/dyjext

# Redis (matches docker-compose.yml for local development)
REDIS_URL=redis://localhost:6379

# API (apps/api). All settings are validated at startup; see apps/api/src/config/config.ts.
API_PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API (the web app).
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120

# Empty scratch database Prisma uses to replay migrations (drift check, migrate dev).
SHADOW_DATABASE_URL=postgresql://dyjext:dyjext_local_only@localhost:5432/dyjext_shadow

# Worker (apps/worker)
WORKER_CONCURRENCY=5
OUTBOX_POLL_MS=1000
# Queue dashboard at http://127.0.0.1:4100/queues. Disabled unless both are set.
# QUEUE_DASHBOARD_USER=ops
# QUEUE_DASHBOARD_PASSWORD=choose-a-long-password
